<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../Models/*.cs" Link="Models/%(Filename)%(Extension)" />
    <Compile Include="../Services/Sql/*.cs" Link="Services/Sql/%(Filename)%(Extension)" />
    <None Include="../Data/PeliculasGuardadas.json" Link="Data/PeliculasGuardadas.json"
          CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="10.0.0" />
    <PackageReference Include="SQLitePCLRaw.lib.e_sqlite3" Version="3.53.3" />
    <InternalsVisibleTo Include="Movies" />
    <InternalsVisibleTo Include="Movies.Desktop" />
  </ItemGroup>
</Project>
