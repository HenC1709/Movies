<Window x:Class="Movies.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Movies" Width="1040" Height="680" MinWidth="740" MinHeight="460"
        WindowStartupLocation="CenterScreen" Background="{StaticResource Perla}"
        FontFamily="Segoe UI" FontSize="15" Foreground="{StaticResource Tinta}"
        UseLayoutRounding="True" Language="es-VE">
    <Window.Resources>
        <Style x:Key="Navegacion" TargetType="Button" BasedOn="{StaticResource Accion}">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,6" />
        </Style>
        <Style x:Key="Portada" TargetType="Button">
            <Setter Property="Margin" Value="6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="AutomationProperties.Name" Value="{Binding Pelicula.Titulo}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Viewbox Stretch="Uniform">
                            <Grid Width="160" Height="240" Background="{StaticResource Tinta}">
                                <Grid.Clip>
                                    <RectangleGeometry Rect="0,0,160,240" RadiusX="8" RadiusY="8" />
                                </Grid.Clip>
                                <Image Style="{StaticResource ImagenPortada}" Stretch="UniformToFill" />
                                <Grid x:Name="Rotulo" Visibility="Collapsed">
                                    <Grid.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0" Color="#00102540" />
                                            <GradientStop Offset=".32" Color="#10102540" />
                                            <GradientStop Offset=".73" Color="#E30C2038" />
                                            <GradientStop Offset="1" Color="#FC0C2038" />
                                        </LinearGradientBrush>
                                    </Grid.Background>
                                    <StackPanel VerticalAlignment="Bottom" Margin="13,12">
                                        <TextBlock Text="{Binding Pelicula.Titulo}" Foreground="White" FontSize="17"
                                                   FontWeight="SemiBold" TextWrapping="Wrap" MaxHeight="175" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Estado}" Foreground="{StaticResource Cian}" FontSize="12"
                                                   FontWeight="SemiBold">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Estado}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                    <Border BorderBrush="{StaticResource Cian}" BorderThickness="2" CornerRadius="8" />
                                </Grid>
                            </Grid>
                        </Viewbox>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Rotulo" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Rotulo" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>
    <Grid Background="{StaticResource Perla}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource Noche}" Padding="22,13">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <Path Width="27" Height="27" Stretch="Uniform" Fill="{StaticResource Cian}"
                          Data="F0 M0,8 L25,1 26,6 1,13 Z M4,7 L7,6 11,10 8,11 Z M14,4 L17,3 21,7 18,8 Z M2,14 H27 V29 H2 Z M12,17 L12,26 20,21.5 Z" />
                    <TextBlock Text="Movies" Foreground="White" FontSize="23" FontWeight="Bold" Margin="8,0,0,0" />
                </StackPanel>
                <StackPanel x:Name="Navegacion" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="_Catálogo" Click="MostrarCatalogo">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Navegacion}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViendoCatalogo}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AzulRey}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Content="_Mi lista" Click="MostrarMiLista" Margin="3,0,0,0">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource Navegacion}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViendoLista}" Value="True">
                                        <Setter Property="Background" Value="{StaticResource AzulRey}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
                <Grid Grid.Column="2" DataContext="{Binding DataContext, ElementName=Navegacion}" Margin="14,0"
                      Visibility="{Binding ViendoCatalogo, Converter={StaticResource Visibilidad}}">
                    <Border HorizontalAlignment="Stretch" MaxWidth="360" Background="{StaticResource Superficie}" CornerRadius="7"
                            VerticalAlignment="Center">
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Click="Buscar" IsEnabled="{Binding PuedeBuscar}"
                                    Style="{StaticResource AccionSecundaria}" Padding="10,4" ToolTip="Buscar" AutomationProperties.Name="Buscar">
                                <Path Stroke="{StaticResource AzulRey}" StrokeThickness="2" StrokeEndLineCap="Round"
                                      Data="M13,13 L18,18 M14,8 A6,6 0 1 1 2,8 A6,6 0 1 1 14,8" />
                            </Button>
                            <Grid Margin="10,0,4,0">
                                <TextBox x:Name="Consulta" Text="{Binding Consulta, UpdateSourceTrigger=PropertyChanged}"
                                         KeyDown="BuscarConEnter" Background="Transparent" BorderThickness="0"
                                         Padding="2,0" VerticalContentAlignment="Center" Foreground="{StaticResource Tinta}"
                                         AutomationProperties.Name="Buscar por título" />
                                <TextBlock Text="Buscar por título" IsHitTestVisible="False" Foreground="#536477"
                                           VerticalAlignment="Center" Margin="4,0">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding Text, ElementName=Consulta}" Value="">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
                <Button Grid.Column="3" Click="AbrirCuenta" VerticalAlignment="Center"
                        ToolTip="Cuenta de usuario" AutomationProperties.Name="Cuenta de usuario" Padding="7,3,11,3" Background="#DBF3EB"
                        Foreground="{StaticResource Tinta}" Style="{StaticResource Navegacion}">
                    <StackPanel Orientation="Horizontal">
                        <Border Width="26" Height="26" CornerRadius="13" Background="{StaticResource Esmeralda}">
                            <Grid>
                                <Path Stroke="White" StrokeThickness="1.6" Stretch="Uniform" Width="14" Height="14"
                                      Visibility="{Binding EsInvitado, Converter={StaticResource Visibilidad}}"
                                      Data="M8,1 A3,3 0 1 1 8,7 A3,3 0 1 1 8,1 Z M1,16 C1,8 15,8 15,16" />
                                <TextBlock Text="{Binding InicialSesion}" Foreground="White" FontFamily="{StaticResource FuenteMovies}"
                                           FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Grid>
                        </Border>
                        <TextBlock Margin="7,0,0,0" MaxWidth="110" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="{Binding NombreSesion}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding EsInvitado}" Value="True">
                                            <Setter Property="Text" Value="Usuario" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

        <Grid Grid.Row="1" Background="{StaticResource FondoGaleria}" ClipToBounds="True" DataContext="{Binding DataContext, ElementName=Navegacion}">
            <Grid.Resources>
                <Style x:Key="ArteGaleria" TargetType="Image">
                    <Setter Property="Source" Value="{StaticResource Proyector}" />
                    <Setter Property="IsHitTestVisible" Value="False" />
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding ViendoLista}" Value="True">
                            <Setter Property="Source" Value="{StaticResource Entradas}" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Grid.Resources>
            <Image Width="260" Height="148" Margin="0,0,32,20" HorizontalAlignment="Right" VerticalAlignment="Bottom" Opacity=".17">
                <Image.Style>
                    <Style TargetType="Image" BasedOn="{StaticResource ArteGaleria}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilasVisibles.Count}" Value="0">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Image.Style>
            </Image>
            <ScrollViewer x:Name="Desplazamiento" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                          Focusable="False">
                <ItemsControl Margin="16,15" VerticalAlignment="Top" ItemsSource="{Binding FilasVisibles}" AutomationProperties.Name="Películas">
                    <ItemsControl.Style>
                        <Style TargetType="ItemsControl">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding FilasVisibles.Count}" Value="1">
                                    <Setter Property="MaxWidth" Value="238" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding FilasVisibles.Count}" Value="2">
                                    <Setter Property="MaxWidth" Value="464" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding FilasVisibles.Count}" Value="3">
                                    <Setter Property="MaxWidth" Value="620" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ItemsControl.Style>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="5" SizeChanged="AjustarColumnas" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Button Style="{StaticResource Portada}" Click="AbrirFicha" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
            <Border HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="420" Margin="24" Padding="24,18"
                    Background="{StaticResource Superficie}" BorderBrush="{StaticResource Linea}" BorderThickness="1" CornerRadius="14">
                <Border.Style>
                    <Style TargetType="Border">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding MensajeVista}" Value="">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <StackPanel>
                    <Image Width="112" Height="64" Style="{StaticResource ArteGaleria}" />
                    <TextBlock Text="{Binding MensajeVista}" AutomationProperties.LiveSetting="Polite"
                               FontFamily="{StaticResource FuenteMovies}" FontSize="18" FontWeight="SemiBold"
                               TextAlignment="Center" TextWrapping="Wrap" Margin="0,12,0,0" />
                    <Button Click="MostrarCatalogo" Margin="0,12,0,0" HorizontalAlignment="Center"
                            Visibility="{Binding PuedeExplorarCatalogo, Converter={StaticResource Visibilidad}}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource AccionSecundaria}">
                                <Setter Property="Content" Value="Ver todo el catálogo" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ViendoLista}" Value="True">
                                        <Setter Property="Content" Value="Explorar el catálogo" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" MinHeight="56" Background="{StaticResource Superficie}" BorderBrush="{StaticResource Linea}"
                BorderThickness="0,1,0,0" Padding="22,10">
            <DockPanel>
                <Button DockPanel.Dock="Right" x:Name="BotonAgregar" Content="＋  _Agregar película" Click="AgregarPelicula"
                        Style="{StaticResource Accion}" Background="{StaticResource Esmeralda}"
                        Visibility="{Binding EsAdministrador, Converter={StaticResource Visibilidad}}" />
                <TextBlock DockPanel.Dock="Left" Text="{Binding DataContext.ResumenVista, ElementName=Navegacion}" Margin="0,0,18,0"
                           VerticalAlignment="Center" Foreground="#536477" />
                <TextBlock x:Name="Aviso" TextWrapping="Wrap" VerticalAlignment="Center" FontWeight="SemiBold"
                           Foreground="{StaticResource Esmeralda}" AutomationProperties.LiveSetting="Polite" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
