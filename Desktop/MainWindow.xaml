<Window x:Class="Movies.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Movies" Width="1040" Height="680" MinWidth="760" MinHeight="480"
        WindowStartupLocation="CenterScreen" Background="#F3F3EF"
        FontFamily="Segoe UI" FontSize="15" Foreground="#172C29"
        UseLayoutRounding="True" Language="es-VE">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#909E98" />
        </Style>
        <Style TargetType="PasswordBox">
            <Setter Property="Height" Value="42" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="BorderBrush" Value="#909E98" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="40" />
            <Setter Property="Padding" Value="16,6" />
            <Setter Property="Background" Value="#1C5045" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Marco" CornerRadius="6" Padding="{TemplateBinding Padding}"
                                BorderThickness="2" BorderBrush="Transparent"
                                Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"
                                              RecognizesAccessKey="True" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Marco" Property="Background" Value="#2B695B" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Marco" Property="BorderBrush" Value="#D79E4A" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Marco" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="BotonConSeleccion" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Style.Triggers>
                <Trigger Property="Tag" Value="{x:Null}">
                    <Setter Property="IsEnabled" Value="False" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <DataTemplate x:Key="MiniaturaCaratula">
            <Image Source="{Binding Caratula, TargetNullValue={StaticResource CaratulaGenerica}}"
                   Width="36" Height="54" Stretch="Uniform" Margin="4,3" />
        </DataTemplate>
    </Window.Resources>
    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="18" />
            <ColumnDefinition Width="290" />
        </Grid.ColumnDefinitions>
        <TextBlock Text="Movies" FontSize="36" FontWeight="Bold" Margin="0,0,0,16"
                   Grid.ColumnSpan="3" />

        <DockPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,12" LastChildFill="True">
            <Button DockPanel.Dock="Left" Content="_Catálogo" Click="MostrarCatalogo" />
            <Button DockPanel.Dock="Left" Content="_Mi lista" Click="MostrarMiLista" Margin="8,0,0,0"
                    Visibility="{Binding TieneSesion, Converter={StaticResource Visibilidad}}" />
            <TextBlock x:Name="Aviso" Margin="12,0,0,0" VerticalAlignment="Center" TextWrapping="Wrap"
                       Foreground="#1C5045" AutomationProperties.LiveSetting="Polite" />
        </DockPanel>

        <Border x:Name="PanelCatalogo" Grid.Row="2" Padding="20" Background="White"
                CornerRadius="12" BorderBrush="#DBE2DB" BorderThickness="1">
          <Grid>
            <Grid Visibility="{Binding ViendoCatalogo, Converter={StaticResource Visibilidad}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <TextBlock Text="Catálogo" FontSize="24" FontWeight="SemiBold" />
                <Label Grid.Row="1" Content="_Título de película" Target="{Binding ElementName=Consulta}"
                       Padding="0,10,0,4" />
                <Grid Grid.Row="2" Margin="0,0,0,16" IsEnabled="{Binding PuedeBuscar}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="Consulta" Text="{Binding Consulta, UpdateSourceTrigger=PropertyChanged}"
                             KeyDown="BuscarConEnter" />
                    <Button Grid.Column="1" Content="Buscar" Click="Buscar" Margin="8,0,0,0" />
                    <Button Grid.Column="2" Content="Ver todo" Click="VerTodo" Margin="8,0,0,0"
                            Background="#345C54" />
                </Grid>
                <Grid Grid.Row="3">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel Margin="0,0,0,6">
                        <Button DockPanel.Dock="Right" Content="Ver _ficha" Click="AbrirFicha"
                                Style="{StaticResource BotonConSeleccion}"
                                Tag="{Binding ElementName=TablaCatalogo, Path=SelectedItem}" />
                        <TextBlock Text="{Binding Resumen}" Foreground="#485C55" VerticalAlignment="Center" />
                    </DockPanel>
                    <DataGrid x:Name="TablaCatalogo" Grid.Row="1" ItemsSource="{Binding Peliculas}" AutoGenerateColumns="False"
                              IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                              HorizontalGridLinesBrush="#E6EBE7" AlternatingRowBackground="#F6F8F6"
                              BorderBrush="#DBE2DB" Background="White"
                              RowHeight="62" SelectionMode="Single" SelectionUnit="FullRow"
                              PreviewKeyDown="FichaConEnter" MouseDoubleClick="FichaConDobleClic"
                              AutomationProperties.Name="Películas del catálogo">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Carátula" Width="66" CellTemplate="{StaticResource MiniaturaCaratula}" />
                            <DataGridTextColumn Header="Título" Binding="{Binding Pelicula.Titulo}" Width="3*" MinWidth="145" />
                            <DataGridTextColumn Header="Autor" Binding="{Binding Pelicula.Autor}" Width="2*" MinWidth="105" />
                            <DataGridTextColumn Header="Ingreso" Binding="{Binding Pelicula.FechaDeIngreso, StringFormat=d}"
                                                Width="Auto" MinWidth="86" />
                        </DataGrid.Columns>
                        <DataGrid.Style>
                            <Style TargetType="DataGrid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Peliculas.Count}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </DataGrid.Style>
                    </DataGrid>
                    <TextBlock Grid.Row="1" Text="{Binding Estado}" AutomationProperties.LiveSetting="Polite"
                               TextWrapping="Wrap" Foreground="#485C55" VerticalAlignment="Top" />
                </Grid>
            </Grid>
            <Grid Visibility="{Binding ViendoLista, Converter={StaticResource Visibilidad}}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <DockPanel Margin="0,0,0,16">
                    <Button DockPanel.Dock="Right" Content="Ver _ficha" Click="AbrirFicha"
                            Style="{StaticResource BotonConSeleccion}"
                            Tag="{Binding ElementName=TablaLista, Path=SelectedItem}" />
                    <TextBlock Text="Mi lista" FontSize="24" FontWeight="SemiBold" VerticalAlignment="Center" />
                </DockPanel>
                <DataGrid x:Name="TablaLista" Grid.Row="1" ItemsSource="{Binding MiLista}" AutoGenerateColumns="False"
                          IsReadOnly="True" HeadersVisibility="Column" GridLinesVisibility="Horizontal"
                          HorizontalGridLinesBrush="#E6EBE7" AlternatingRowBackground="#F6F8F6"
                          BorderBrush="#DBE2DB" Background="White"
                          RowHeight="62" SelectionMode="Single" SelectionUnit="FullRow"
                          PreviewKeyDown="FichaConEnter" MouseDoubleClick="FichaConDobleClic"
                          AutomationProperties.Name="Mi lista de películas">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Header="Carátula" Width="66" CellTemplate="{StaticResource MiniaturaCaratula}" />
                        <DataGridTextColumn Header="Título" Binding="{Binding Pelicula.Titulo}" Width="3*" MinWidth="145" />
                        <DataGridTextColumn Header="Autor" Binding="{Binding Pelicula.Autor}" Width="2*" MinWidth="105" />
                        <DataGridTextColumn Header="Estado" Binding="{Binding Estado}" Width="Auto" MinWidth="86" />
                    </DataGrid.Columns>
                    <DataGrid.Style>
                        <Style TargetType="DataGrid">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding MiLista.Count}" Value="0">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </DataGrid.Style>
                </DataGrid>
                <TextBlock Grid.Row="1" Text="{Binding EstadoLista}" AutomationProperties.LiveSetting="Polite"
                           Foreground="#485C55" TextWrapping="Wrap" VerticalAlignment="Top" />
            </Grid>
          </Grid>
        </Border>

        <ScrollViewer Grid.Row="2" Grid.Column="2" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Padding="20" Background="White" CornerRadius="12" VerticalAlignment="Top"
                    BorderBrush="#DBE2DB" BorderThickness="1">
                <Grid>
                    <StackPanel Visibility="{Binding EsInvitado, Converter={StaticResource Visibilidad}}"
                                IsEnabled="{Binding PuedeInteractuar}" KeyDown="AccederConEnter">
                        <TextBlock Text="{Binding TituloFormulario}" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Ayuda}" TextWrapping="Wrap" Foreground="#485C55"
                                   Margin="0,6,0,14" />
                        <Label Content="_Nombre" Target="{Binding ElementName=Nombre}" Padding="0,4" />
                        <TextBox x:Name="Nombre" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}"
                                 Margin="0,0,0,10" />
                        <Label Content="_Contraseña" Target="{Binding ElementName=Clave}" Padding="0,4" />
                        <PasswordBox x:Name="Clave" />
                        <TextBlock Text="{Binding Mensaje}" AutomationProperties.LiveSetting="Polite"
                                   Foreground="#8C3D26" TextWrapping="Wrap" Margin="0,8,0,12" />
                        <Button Content="{Binding TituloFormulario}" Click="Acceder" />
                        <Button Content="{Binding AccionAlternativa}" Click="CambiarFormulario"
                                Background="#345C54" Margin="0,8,0,0" />
                    </StackPanel>
                    <StackPanel Visibility="{Binding TieneSesion, Converter={StaticResource Visibilidad}}">
                        <TextBlock Text="Sesión iniciada" FontSize="24" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding NombreSesion}" FontSize="18" TextWrapping="Wrap"
                                   Margin="0,10,0,2" />
                        <TextBlock Text="{Binding RolSesion}" Foreground="#485C55" />
                        <Button Content="_Agregar película" Click="AgregarPelicula" Margin="0,16,0,0"
                                Visibility="{Binding EsAdministrador, Converter={StaticResource Visibilidad}}" />
                        <Button Content="Cerrar sesión" Click="CerrarSesion" Margin="0,8,0,0" />
                    </StackPanel>
                </Grid>
            </Border>
            <Expander Header="Créditos" Margin="0,14,0,0">
                <StackPanel Margin="16,10,8,8">
                    <Image Source="{StaticResource LogoTmdb}" Width="100" Stretch="Uniform"
                           HorizontalAlignment="Left" AutomationProperties.Name="TMDB" />
                    <TextBlock Text="This product uses the TMDB API but is not endorsed or certified by TMDB."
                               Margin="0,8,0,0" TextWrapping="Wrap" FontSize="13" />
                </StackPanel>
            </Expander>
          </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
