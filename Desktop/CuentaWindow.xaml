<local:DialogoAnimado x:Class="Movies.Desktop.CuentaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Movies.Desktop"
        Title="Usuario" Width="460" SizeToContent="Height" MaxHeight="620"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Perla}" Foreground="{StaticResource Tinta}" FontFamily="{StaticResource FuenteMovies}"
        FontSize="16" UseLayoutRounding="True" Language="es-VE">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Margin="15" CornerRadius="14" Background="{StaticResource Superficie}" BorderBrush="{StaticResource Linea}" BorderThickness="1">
            <StackPanel>
                <StackPanel x:Name="Formulario">
                    <Border Background="{StaticResource CabeceraCuenta}" CornerRadius="13,13,0,0" Padding="21,18">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="85" /></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding TituloFormulario}" Style="{StaticResource TituloDialogo}" />
                                <TextBlock Text="{Binding Ayuda}" Foreground="{StaticResource TintaSecundaria}"
                                           TextWrapping="Wrap" Margin="0,5,10,0" />
                            </StackPanel>
                            <Image Grid.Column="1" Source="{StaticResource Entradas}" VerticalAlignment="Center"
                                   IsHitTestVisible="False" />
                        </Grid>
                    </Border>
                    <StackPanel Margin="21,17,21,0" IsEnabled="{Binding PuedeInteractuar}">
                        <Label Content="_Nombre" Target="{Binding ElementName=Nombre}" Style="{StaticResource EtiquetaCampo}" />
                        <TextBox x:Name="Nombre" Text="{Binding Nombre, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource Campo}" />
                        <Label Content="_Contraseña" Target="{Binding ElementName=Clave}" Margin="0,11,0,0"
                               Style="{StaticResource EtiquetaCampo}" />
                        <PasswordBox x:Name="Clave" Style="{StaticResource Campo}" />
                        <TextBlock Style="{StaticResource MensajeFormulario}" Margin="0,6,0,0" />
                        <WrapPanel Margin="0,13,0,0">
                            <Button Content="{Binding TituloFormulario}" Click="Acceder" IsDefault="True" Style="{StaticResource Accion}" />
                            <Button Content="{Binding AccionAlternativa}" Click="CambiarFormulario" Margin="8,0,0,0"
                                    Style="{StaticResource AccionSecundaria}" />
                        </WrapPanel>
                    </StackPanel>
                </StackPanel>
                <StackPanel x:Name="Perfil">
                    <Border Background="{StaticResource CabeceraCuenta}" CornerRadius="13,13,0,0" Padding="21,22">
                        <DockPanel>
                            <Border DockPanel.Dock="Left" Width="58" Height="58" CornerRadius="29" Margin="0,0,14,0"
                                    Background="{StaticResource Esmeralda}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding InicialSesion, Mode=OneTime}" Foreground="White" FontSize="28"
                                           FontWeight="SemiBold" VerticalAlignment="Center" HorizontalAlignment="Center" />
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding NombreSesion, Mode=OneTime}" Style="{StaticResource TituloDialogo}" />
                                <TextBlock Text="{Binding RolSesion, Mode=OneTime}" Foreground="{StaticResource TintaSecundaria}" Margin="0,2,0,0" />
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Button Content="Cerrar _sesión" Click="CerrarSesion" HorizontalAlignment="Left" Margin="21,18,21,0"
                            Style="{StaticResource AccionSecundaria}" Background="{StaticResource Menta}" />
                </StackPanel>
                <Border Margin="21,17,21,0" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Linea}" />
                <DockPanel Margin="21,11,21,14">
                    <Button DockPanel.Dock="Right" Content="_Cerrar" IsCancel="True" IsEnabled="{Binding PuedeInteractuar}"
                            Style="{StaticResource AccionSecundaria}" VerticalAlignment="Top" />
                    <Expander Header="Créditos" VerticalAlignment="Center" Margin="0,0,10,0">
                        <StackPanel Margin="5,9,2,3">
                            <Image Source="{StaticResource LogoTmdb}" Width="100" HorizontalAlignment="Left" AutomationProperties.Name="TMDB" />
                            <TextBlock Text="This product uses the TMDB API but is not endorsed or certified by TMDB."
                                       Margin="0,8,0,0" TextWrapping="Wrap" FontSize="13" />
                        </StackPanel>
                    </Expander>
                </DockPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</local:DialogoAnimado>
