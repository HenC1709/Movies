<Window x:Class="Movies.Desktop.FichaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{Binding Encabezado}" Width="480" SizeToContent="Height" MaxHeight="560"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="#F3F3EF" FontFamily="Segoe UI" FontSize="15" Language="es-VE">
    <Window.Resources>
        <Style TargetType="TextBox">
            <Setter Property="MinHeight" Value="38" />
            <Setter Property="Padding" Value="8" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="Padding" Value="12,4" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>
    </Window.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="White" CornerRadius="12" Padding="22" Margin="16">
            <StackPanel>
                <StackPanel Visibility="{Binding EsFicha, Converter={StaticResource Visibilidad}}">
                    <DockPanel>
                        <Image DockPanel.Dock="Left" Width="150" Height="225" Stretch="Uniform" VerticalAlignment="Top"
                               Margin="0,0,16,0" AutomationProperties.Name="Carátula de la película"
                               Source="{Binding Caratula, TargetNullValue={StaticResource CaratulaGenerica}}" />
                        <StackPanel>
                            <TextBlock Text="{Binding Titulo}" TextWrapping="Wrap" FontSize="27" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Autor, StringFormat='Autor · {0}'}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding Fecha, StringFormat='Ingreso al catálogo · {0}'}"
                                       TextWrapping="Wrap" Margin="0,4,0,14" />
                            <TextBlock Text="{Binding Estado}" Foreground="#1C5045" TextWrapping="Wrap" />
                            <TextBlock Text="Inicia sesión para añadirla a tu lista." TextWrapping="Wrap"
                                       Visibility="{Binding EsInvitado, Converter={StaticResource Visibilidad}}" />
                        </StackPanel>
                    </DockPanel>
                    <WrapPanel IsEnabled="{Binding PuedeInteractuar}" Margin="0,12,0,0"
                               Visibility="{Binding PuedeMarcar, Converter={StaticResource Visibilidad}}">
                        <Button x:Name="Pendiente" Content="Marcar _pendiente" Click="MarcarPendiente" />
                        <Button x:Name="Vista" Content="Marcar _vista" Click="MarcarVista" />
                        <Button Content="_Editar" Click="Editar"
                                Visibility="{Binding PuedeEditar, Converter={StaticResource Visibilidad}}" />
                    </WrapPanel>
                </StackPanel>
                <StackPanel Visibility="{Binding EsFormulario, Converter={StaticResource Visibilidad}}"
                            IsEnabled="{Binding PuedeInteractuar}">
                    <TextBlock Text="{Binding Encabezado}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,12" />
                    <Label Content="_Título" Target="{Binding ElementName=CampoTitulo}" />
                    <TextBox x:Name="CampoTitulo" Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}" />
                    <Label Content="_Autor" Target="{Binding ElementName=CampoAutor}" Margin="0,8,0,0" />
                    <TextBox x:Name="CampoAutor" Text="{Binding Autor, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="Carátula" FontWeight="SemiBold" Margin="0,16,0,4" />
                    <DockPanel Margin="0,0,0,8">
                        <Image DockPanel.Dock="Left" Width="44" Height="66" Stretch="Uniform" Margin="0,0,10,0"
                               Source="{Binding Caratula, TargetNullValue={StaticResource CaratulaGenerica}}" />
                        <TextBlock Text="{Binding ResumenCaratula}" TextWrapping="Wrap" VerticalAlignment="Center"
                                   AutomationProperties.LiveSetting="Polite" />
                    </DockPanel>
                    <WrapPanel>
                        <Button x:Name="BotonElegirCaratula" Content="Elegir _imagen…" Click="ElegirCaratula" />
                        <Button Content="_Quitar carátula" Click="QuitarCaratula"
                                IsEnabled="{Binding PuedeQuitarCaratula}" />
                        <Button x:Name="BotonBuscarTmdb" Content="Buscar en _TMDB" Click="BuscarEnTmdb" />
                    </WrapPanel>
                    <StackPanel Margin="0,10,0,0"
                                Visibility="{Binding HayResultadosTmdb, Converter={StaticResource Visibilidad}}">
                        <Label Content="_Resultados de TMDB" Target="{Binding ElementName=CoincidenciasTmdb}" />
                        <ComboBox x:Name="CoincidenciasTmdb" ItemsSource="{Binding ResultadosTmdb}" DisplayMemberPath="Etiqueta"
                                  MinHeight="32" />
                        <Button Content="_Usar carátula" Click="UsarResultadoTmdb" HorizontalAlignment="Left"
                                Margin="0,6,0,0" />
                    </StackPanel>
                    <Button x:Name="GuardarPelicula" Content="_Guardar" Click="Guardar" IsDefault="True"
                            HorizontalAlignment="Left" Margin="0,16,0,0" />
                </StackPanel>
                <TextBlock Text="{Binding Mensaje}" AutomationProperties.LiveSetting="Polite"
                           Foreground="#8C3D26" TextWrapping="Wrap" Margin="0,8,0,0" />
                <Button x:Name="Cerrar" Content="_Cerrar" IsCancel="True" IsEnabled="{Binding PuedeInteractuar}"
                        HorizontalAlignment="Right" Margin="0,6,0,0" />
            </StackPanel>
        </Border>
    </ScrollViewer>
</Window>
