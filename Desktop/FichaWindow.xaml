<local:DialogoAnimado x:Class="Movies.Desktop.FichaWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Movies.Desktop"
        Title="{Binding Encabezado}" Width="540" SizeToContent="Height" MaxHeight="660"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="{StaticResource Perla}" Foreground="{StaticResource Tinta}" FontFamily="{StaticResource FuenteMovies}"
        FontSize="16" UseLayoutRounding="True" Language="es-VE">
    <local:DialogoAnimado.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource AccionSecundaria}">
            <Setter Property="Padding" Value="10,4" />
            <Setter Property="Margin" Value="0,0,6,5" />
        </Style>
    </local:DialogoAnimado.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Border Background="{StaticResource Superficie}" CornerRadius="14" Margin="15"
                BorderBrush="{StaticResource Linea}" BorderThickness="1">
            <StackPanel>
                <StackPanel Margin="21,20,21,0" Visibility="{Binding EsFicha, Converter={StaticResource Visibilidad}}">
                    <DockPanel>
                        <Image DockPanel.Dock="Left" Width="150" Height="225" Stretch="Uniform" VerticalAlignment="Top"
                               Margin="0,0,16,0" AutomationProperties.Name="Carátula de la película"
                               Style="{StaticResource ImagenPortada}" />
                        <StackPanel>
                            <TextBlock Text="{Binding Titulo}" Style="{StaticResource TituloDialogo}" />
                            <TextBlock Text="{Binding Autor, StringFormat='Autor · {0}'}" TextWrapping="Wrap" Margin="0,8,0,0" />
                            <TextBlock Text="{Binding Fecha, StringFormat='Ingreso al catálogo · {0}'}"
                                       TextWrapping="Wrap" Margin="0,4,0,14" />
                            <TextBlock Text="{Binding Estado}" Foreground="{StaticResource Esmeralda}" TextWrapping="Wrap" />
                            <TextBlock Text="Inicia sesión para añadirla a tu lista." TextWrapping="Wrap"
                                       Visibility="{Binding EsInvitado, Converter={StaticResource Visibilidad}}" />
                        </StackPanel>
                    </DockPanel>
                    <StackPanel Margin="0,16,0,0" Visibility="{Binding TieneSinopsis, Converter={StaticResource Visibilidad}}">
                        <TextBlock Text="Sinopsis" FontSize="19" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding Sinopsis}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    </StackPanel>
                    <WrapPanel IsEnabled="{Binding PuedeInteractuar}" Margin="0,12,0,0"
                               Visibility="{Binding PuedeMarcar, Converter={StaticResource Visibilidad}}">
                        <Button x:Name="Pendiente" Content="Marcar _pendiente" Click="MarcarPendiente" />
                        <Button x:Name="Vista" Content="Marcar _vista" Click="MarcarVista" />
                        <Button Content="_Editar" Click="Editar"
                                Visibility="{Binding PuedeEditar, Converter={StaticResource Visibilidad}}" />
                    </WrapPanel>
                </StackPanel>
                <StackPanel Visibility="{Binding EsFormulario, Converter={StaticResource Visibilidad}}" IsEnabled="{Binding PuedeInteractuar}">
                    <Border Background="{StaticResource CabeceraEdicion}" CornerRadius="13,13,0,0" Padding="21,12">
                        <DockPanel>
                            <Image DockPanel.Dock="Right" Source="{StaticResource Proyector}" Width="92" Height="57"
                                   Margin="10,0,0,0" IsHitTestVisible="False" />
                            <TextBlock Text="{Binding Encabezado}" Style="{StaticResource TituloDialogo}" VerticalAlignment="Center" />
                        </DockPanel>
                    </Border>
                    <StackPanel Margin="21,16,21,0">
                        <Label Content="_Título" Target="{Binding ElementName=CampoTitulo}" Style="{StaticResource EtiquetaCampo}" />
                        <TextBox x:Name="CampoTitulo" Text="{Binding Titulo, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Campo}" TextWrapping="Wrap" />
                        <Label Content="_Autor" Target="{Binding ElementName=CampoAutor}" Style="{StaticResource EtiquetaCampo}" Margin="0,10,0,0" />
                        <TextBox x:Name="CampoAutor" Text="{Binding Autor, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Campo}" TextWrapping="Wrap" />
                        <Label Content="_Sinopsis (opcional)" Target="{Binding ElementName=CampoSinopsis}"
                               Style="{StaticResource EtiquetaCampo}" Margin="0,10,0,0" />
                        <TextBox x:Name="CampoSinopsis" Text="{Binding Sinopsis, UpdateSourceTrigger=PropertyChanged}"
                                 Style="{StaticResource Campo}" AcceptsReturn="True" TextWrapping="Wrap" Height="92"
                                 VerticalContentAlignment="Stretch" VerticalScrollBarVisibility="Auto" />
                        <Border Margin="0,16,0,0" CornerRadius="9" Background="#EAF5EF" Padding="12">
                            <StackPanel>
                                <DockPanel>
                                    <Image DockPanel.Dock="Left" Width="52" Height="78" Margin="0,0,13,0" VerticalAlignment="Top"
                                           Style="{StaticResource ImagenPortada}" Stretch="Uniform" />
                                    <StackPanel>
                                        <TextBlock Text="Carátula" FontSize="19" FontWeight="SemiBold" />
                                        <TextBlock Text="{Binding ResumenCaratula}" TextWrapping="Wrap" Foreground="{StaticResource TintaSecundaria}"
                                                   AutomationProperties.LiveSetting="Polite" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button x:Name="BotonElegirCaratula" Content="Elegir _imagen…" Click="ElegirCaratula" Background="#D1E9E3" />
                                            <Button x:Name="BotonBuscarTmdb" Content="Buscar en _TMDB" Click="BuscarEnTmdb" Background="#DAE4F8" />
                                            <Button Content="_Quitar carátula" Click="QuitarCaratula"
                                                    Visibility="{Binding PuedeQuitarCaratula, Converter={StaticResource Visibilidad}}" />
                                        </WrapPanel>
                                    </StackPanel>
                                </DockPanel>
                                <StackPanel Margin="0,10,0,0" Visibility="{Binding HayResultadosTmdb, Converter={StaticResource Visibilidad}}">
                                    <Label Content="_Resultados de TMDB" Target="{Binding ElementName=CoincidenciasTmdb}" Style="{StaticResource EtiquetaCampo}" />
                                    <ComboBox x:Name="CoincidenciasTmdb" ItemsSource="{Binding ResultadosTmdb}" DisplayMemberPath="Etiqueta" MinHeight="32" />
                                    <Button Content="_Usar resultado" Click="UsarResultadoTmdb" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
                <TextBlock Style="{StaticResource MensajeFormulario}" Margin="21,8,21,0" />
                <Border Margin="21,12,21,0" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Linea}" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="21,10,21,14" IsEnabled="{Binding PuedeInteractuar}">
                    <Button x:Name="Cerrar" Content="_Cerrar" IsCancel="True" Style="{StaticResource AccionSecundaria}" />
                    <Button x:Name="GuardarPelicula" Content="_Guardar" Click="Guardar" IsDefault="{Binding EsFormulario}" Margin="8,0,0,0"
                            Visibility="{Binding EsFormulario, Converter={StaticResource Visibilidad}}"
                            Style="{StaticResource Accion}" Background="{StaticResource Esmeralda}" />
                </StackPanel>
            </StackPanel>
        </Border>
    </ScrollViewer>
</local:DialogoAnimado>
