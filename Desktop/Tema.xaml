<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="Perla" Color="#F4F4EF" />
    <SolidColorBrush x:Key="Superficie" Color="#FCFCF8" />
    <SolidColorBrush x:Key="Tinta" Color="#122541" />
    <SolidColorBrush x:Key="AzulRey" Color="#294DCF" />
    <SolidColorBrush x:Key="Cian" Color="#41D9E0" />
    <SolidColorBrush x:Key="Esmeralda" Color="#007C66" />
    <SolidColorBrush x:Key="Linea" Color="#CCD7D6" />
    <FontFamily x:Key="FuenteMovies">pack://application:,,,/Movies.Desktop;component/Fuentes/#Barlow, Segoe UI</FontFamily>
    <SolidColorBrush x:Key="TintaSecundaria" Color="#40596B" />
    <SolidColorBrush x:Key="Menta" Color="#DBF1E7" />
    <LinearGradientBrush x:Key="CabeceraCuenta" StartPoint="0,0" EndPoint="1,.8">
        <GradientStop Offset="0" Color="#DBF3E6" />
        <GradientStop Offset=".55" Color="#BDEDE6" />
        <GradientStop Offset="1" Color="#A8D5EF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="CabeceraEdicion" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#E3E6FC" />
        <GradientStop Offset=".60" Color="#D0DFF5" />
        <GradientStop Offset="1" Color="#BAE9E4" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="FondoGaleria" StartPoint=".2,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#F6F5F0" />
        <GradientStop Offset=".65" Color="#F0F3EC" />
        <GradientStop Offset="1" Color="#DCEEE6" />
    </LinearGradientBrush>
    <Style x:Key="TituloDialogo" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FuenteMovies}" />
        <Setter Property="FontSize" Value="31" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="EtiquetaCampo" TargetType="Label">
        <Setter Property="Padding" Value="0,0,0,5" />
        <Setter Property="Foreground" Value="{StaticResource TintaSecundaria}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style x:Key="MensajeFormulario" TargetType="TextBlock">
        <Setter Property="Text" Value="{Binding Mensaje}" />
        <Setter Property="Foreground" Value="#893E2D" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="AutomationProperties.LiveSetting" Value="Polite" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Mensaje}" Value="">
                <Setter Property="Visibility" Value="Collapsed" />
            </DataTrigger>
        </Style.Triggers>
    </Style>
    <Style x:Key="Campo" TargetType="Control">
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="Padding" Value="11,6" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{StaticResource Tinta}" />
        <Setter Property="Background" Value="#F7FAF9" />
        <Setter Property="BorderBrush" Value="#9CB5B9" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Control">
                    <Border x:Name="Marco" CornerRadius="7" Background="{TemplateBinding Background}"
                            BorderThickness="1" BorderBrush="{TemplateBinding BorderBrush}">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"
                                      Margin="{TemplateBinding Padding}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter TargetName="Marco" Property="BorderBrush" Value="{StaticResource AzulRey}" />
                            <Setter TargetName="Marco" Property="Background" Value="White" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <!-- Un proyector para el catálogo y dos entradas para la lista y la cuenta. -->
    <DrawingImage x:Key="Proyector">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <GeometryDrawing Brush="#B4E9DC" Geometry="M112,65 L199,29 V114 L112,81 Z" />
                <GeometryDrawing Brush="#317E86" Geometry="M22,60 H100 Q107,60 107,67 V98 Q107,104 100,104 H22 Q16,104 16,98 V66 Q16,60 22,60Z" />
                <GeometryDrawing Brush="#385DAB" Geometry="F0 M17,38 A20,20 0 1 0 57,38 A20,20 0 1 0 17,38Z M33,38 A4,4 0 1 0 41,38 A4,4 0 1 0 33,38Z M33,26 A4,4 0 1 0 41,26 A4,4 0 1 0 33,26Z M23,43 A4,4 0 1 0 31,43 A4,4 0 1 0 23,43Z M43,43 A4,4 0 1 0 51,43 A4,4 0 1 0 43,43Z" />
                <GeometryDrawing Brush="#285C78" Geometry="F0 M58,33 A25,25 0 1 0 108,33 A25,25 0 1 0 58,33Z M79,33 A4,4 0 1 0 87,33 A4,4 0 1 0 79,33Z M78,18 A5,5 0 1 0 88,18 A5,5 0 1 0 78,18Z M65,40 A5,5 0 1 0 75,40 A5,5 0 1 0 65,40Z M91,40 A5,5 0 1 0 101,40 A5,5 0 1 0 91,40Z" />
                <GeometryDrawing Brush="#143F60" Geometry="M106,70 L121,63 V87 L106,80 Z M38,104 H46 L42,114 H32 Z M77,104 H85 L92,114 H82 Z" />
                <GeometryDrawing Brush="#8FE2D2" Geometry="M26,72 H54 V75 H26Z M26,80 H46 V83 H26Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="Entradas">
        <DrawingImage.Drawing>
            <DrawingGroup>
                <DrawingGroup>
                    <DrawingGroup.Transform><RotateTransform Angle="-12" CenterX="86" CenterY="57" /></DrawingGroup.Transform>
                    <GeometryDrawing Brush="#598CBC" Geometry="M18,18 H144 V30 Q135,33 135,40 Q135,47 144,50 V64 H18 V51 Q27,48 27,41 Q27,34 18,31Z" />
                </DrawingGroup>
                <DrawingGroup>
                    <DrawingGroup.Transform><RotateTransform Angle="8" CenterX="91" CenterY="72" /></DrawingGroup.Transform>
                    <GeometryDrawing Brush="#328474" Geometry="M35,43 H163 V56 Q154,59 154,66 Q154,73 163,76 V90 H35 V77 Q44,74 44,67 Q44,60 35,57Z" />
                    <GeometryDrawing Brush="#D5F2DF" Geometry="M59,54 H95 V58 H59Z M59,65 H109 V68 H59Z M59,74 H87 V77 H59Z M122,46 H124 V52 H122Z M122,58 H124 V64 H122Z M122,70 H124 V76 H122Z M122,82 H124 V88 H122Z" />
                </DrawingGroup>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>

    <Style x:Key="Accion" TargetType="Button">
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{StaticResource AzulRey}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Borde" Background="{TemplateBinding Background}" CornerRadius="7"
                            BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                        <Grid>
                            <Border x:Name="Luz" Background="White" CornerRadius="5" Opacity="0" />
                            <ContentPresenter RecognizesAccessKey="True" Margin="{TemplateBinding Padding}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Luz" Property="Opacity" Value=".15" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Borde" Property="BorderBrush" Value="{StaticResource Cian}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Luz" Property="Opacity" Value=".26" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Borde" Property="Opacity" Value=".55" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AccionSecundaria" TargetType="Button" BasedOn="{StaticResource Accion}">
        <Setter Property="Background" Value="#E8EEF5" />
        <Setter Property="Foreground" Value="{StaticResource Tinta}" />
    </Style>
    <LinearGradientBrush x:Key="Noche" StartPoint="0,1" EndPoint="1,0">
        <GradientStop Offset="0" Color="#10294F" />
        <GradientStop Offset="1" Color="#3559CB" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="Aurora" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#63EBDA" />
        <GradientStop Offset=".55" Color="#13AA9B" />
        <GradientStop Offset="1" Color="#055963" />
    </LinearGradientBrush>
    <!-- Ilustraciones de reserva para las películas que aún no tienen una imagen legible. -->
    <DrawingImage x:Key="Orbita">
        <DrawingImage.Drawing>
            <DrawingGroup ClipGeometry="M0,0 H160 V240 H0 Z">
                <GeometryDrawing Brush="{StaticResource Noche}" Geometry="M0,0 H160 V240 H0 Z" />
                <GeometryDrawing Brush="{StaticResource Aurora}" Geometry="M-20,240 C-12,163 29,104 103,77 C153,59 188,69 193,73 L193,240 Z" />
                <GeometryDrawing Brush="#17488A" Geometry="M-10,240 C52,179 103,181 166,206 V240 Z" />
                <GeometryDrawing Brush="#CEF5DA" Geometry="M43,50 A11,11 0 1 0 65,50 A11,11 0 1 0 43,50 Z" />
                <GeometryDrawing Geometry="M-12,210 C3,116 91,44 175,54">
                    <GeometryDrawing.Pen><Pen Brush="#87DDDB" Thickness="1" /></GeometryDrawing.Pen>
                </GeometryDrawing>
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="Haz">
        <DrawingImage.Drawing>
            <DrawingGroup ClipGeometry="M0,0 H160 V240 H0 Z">
                <GeometryDrawing Brush="#172A4D" Geometry="M0,0 H160 V240 H0 Z" />
                <GeometryDrawing Brush="{StaticResource Noche}" Geometry="M0,0 H160 V136 L0,204 Z" />
                <GeometryDrawing Brush="{StaticResource Aurora}" Geometry="M-6,49 L174,146 V243 L-6,87 Z" />
                <GeometryDrawing Brush="#BBF2CD" Geometry="M-6,49 L174,146 V156 L-6,54 Z" />
                <GeometryDrawing Brush="#2876AD" Geometry="M0,207 L160,134 V175 L0,228 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="Anillos">
        <DrawingImage.Drawing>
            <DrawingGroup ClipGeometry="M0,0 H160 V240 H0 Z">
                <GeometryDrawing Brush="{StaticResource Aurora}" Geometry="M0,0 H160 V240 H0 Z" />
                <GeometryDrawing Geometry="M-94,128 A104,104 0 1 0 114,128 A104,104 0 1 0 -94,128 Z">
                    <GeometryDrawing.Pen><Pen Brush="#143D63" Thickness="29" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Geometry="M-59,128 A69,69 0 1 0 79,128 A69,69 0 1 0 -59,128 Z">
                    <GeometryDrawing.Pen><Pen Brush="#96E9CF" Thickness="13" /></GeometryDrawing.Pen>
                </GeometryDrawing>
                <GeometryDrawing Brush="#244AAD" Geometry="M0,93 A35,35 0 1 1 0,161 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <DrawingImage x:Key="Escalera">
        <DrawingImage.Drawing>
            <DrawingGroup ClipGeometry="M0,0 H160 V240 H0 Z">
                <GeometryDrawing Brush="#D1EBE1" Geometry="M0,0 H160 V240 H0 Z" />
                <GeometryDrawing Brush="{StaticResource Aurora}" Geometry="M0,173 H28 V146 H56 V119 H84 V92 H112 V65 H140 V38 H160 V240 H0 Z" />
                <GeometryDrawing Brush="{StaticResource Noche}" Geometry="M0,210 H28 V183 H56 V156 H84 V129 H112 V102 H140 V75 H160 V240 H0 Z" />
                <GeometryDrawing Brush="#2B52B9" Geometry="M25,49 A14,14 0 1 0 53,49 A14,14 0 1 0 25,49 Z" />
            </DrawingGroup>
        </DrawingImage.Drawing>
    </DrawingImage>
    <Style x:Key="ImagenPortada" TargetType="Image">
        <Setter Property="Source" Value="{Binding Caratula}" />
        <Setter Property="RenderOptions.BitmapScalingMode" Value="HighQuality" />
        <Style.Triggers>
            <DataTrigger Binding="{Binding Caratula}" Value="{x:Null}">
                <Setter Property="Source" Value="{StaticResource Orbita}" />
            </DataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Caratula}" Value="{x:Null}" />
                    <Condition Binding="{Binding VariantePortada}" Value="1" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Source" Value="{StaticResource Haz}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Caratula}" Value="{x:Null}" />
                    <Condition Binding="{Binding VariantePortada}" Value="2" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Source" Value="{StaticResource Anillos}" />
            </MultiDataTrigger>
            <MultiDataTrigger>
                <MultiDataTrigger.Conditions>
                    <Condition Binding="{Binding Caratula}" Value="{x:Null}" />
                    <Condition Binding="{Binding VariantePortada}" Value="3" />
                </MultiDataTrigger.Conditions>
                <Setter Property="Source" Value="{StaticResource Escalera}" />
            </MultiDataTrigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
